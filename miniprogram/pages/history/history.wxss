.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.history-item {
  transition: all 0.2s;
}

.history-item:active {
  transform: scale(0.98);
}

.preview-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.preview-content {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  width: 100%;
  max-height: 80vh;
  overflow: hidden;
}

.markdown-text {
  font-family: monospace;
  font-size: 26rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  word-wrap: break-word;
}